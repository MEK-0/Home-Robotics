<?xml version="1.0"?>
<package format="3">
  <name>home_robotics_moveit_config</name>
  <version>0.1.0</version>
  <description>Initial MoveIt 2 configuration for the dual-Panda Home-Robotics system.</description>
  <maintainer email="esat.kolay19@gmail.com">mek</maintainer>
  <license>NOASSERTION</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <test_depend>ament_cmake_pytest</test_depend>

  <depend>moveit_msgs</depend>
  <depend>ament_index_cpp</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>rclcpp</depend>

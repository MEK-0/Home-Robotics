<?xml version="1.0"?>
<robot name="home_robotics">
  <group name="panda1_manipulator">
    <chain base_link="shared_rail" tip_link="panda1_tcp"/>
  </group>
  <group name="panda2_manipulator">
    <chain base_link="shared_rail" tip_link="panda2_tcp"/>
  </group>
  <group name="panda1_gripper">
    <joint name="panda1_finger_joint1"/>
    <joint name="panda1_finger_joint2"/>
  </group>
  <group name="panda2_gripper">
    <joint name="panda2_finger_joint1"/>
    <joint name="panda2_finger_joint2"/>
  </group>

  <end_effector name="panda1_end_effector" parent_link="panda1_tcp" group="panda1_gripper" parent_group="panda1_manipulator"/>
  <end_effector name="panda2_end_effector" parent_link="panda2_tcp" group="panda2_gripper" parent_group="panda2_manipulator"/>

  <!-- Only adjacent or permanently fixed-connected touching geometry is disabled. -->
  <disable_collisions link1="shared_rail" link2="panda1_carriage" reason="Adjacent"/>
  <disable_collisions link1="shared_rail" link2="panda2_carriage" reason="Adjacent"/>
  <disable_collisions link1="panda1_carriage" link2="panda1_link0" reason="Adjacent"/>
  <disable_collisions link1="panda2_carriage" link2="panda2_link0" reason="Adjacent"/>
  <disable_collisions link1="panda1_link0" link2="panda1_link1" reason="Adjacent"/>
  <disable_collisions link1="panda1_link1" link2="panda1_link2" reason="Adjacent"/>
  <disable_collisions link1="panda1_link2" link2="panda1_link3" reason="Adjacent"/>
  <disable_collisions link1="panda1_link3" link2="panda1_link4" reason="Adjacent"/>
  <disable_collisions link1="panda1_link4" link2="panda1_link5" reason="Adjacent"/>
  <disable_collisions link1="panda1_link5" link2="panda1_link6" reason="Adjacent"/>
  <disable_collisions link1="panda1_link6" link2="panda1_link7" reason="Adjacent"/>
  <disable_collisions link1="panda1_link7" link2="panda1_hand" reason="Adjacent"/>
  <disable_collisions link1="panda1_hand" link2="panda1_left_finger" reason="Adjacent"/>
  <disable_collisions link1="panda1_hand" link2="panda1_right_finger" reason="Adjacent"/>
  <disable_collisions link1="panda2_link0" link2="panda2_link1" reason="Adjacent"/>
  <disable_collisions link1="panda2_link1" link2="panda2_link2" reason="Adjacent"/>
  <disable_collisions link1="panda2_link2" link2="panda2_link3" reason="Adjacent"/>
  <disable_collisions link1="panda2_link3" link2="panda2_link4" reason="Adjacent"/>
  <disable_collisions link1="panda2_link4" link2="panda2_link5" reason="Adjacent"/>
  <disable_collisions link1="panda2_link5" link2="panda2_link6" reason="Adjacent"/>
  <disable_collisions link1="panda2_link6" link2="panda2_link7" reason="Adjacent"/>
  <disable_collisions link1="panda2_link7" link2="panda2_hand" reason="Adjacent"/>
  <disable_collisions link1="panda2_hand" link2="panda2_left_finger" reason="Adjacent"/>
  <disable_collisions link1="panda2_hand" link2="panda2_right_finger" reason="Adjacent"/>
</robot>
